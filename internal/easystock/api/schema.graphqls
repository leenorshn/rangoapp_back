# Contract for POST /graphql. The executable schema is graphql.go.
# Amounts and quantities are decimal strings, never floats.
# Dates use the DateTime scalar (RFC3339).

type Query {
  subscription: Subscription!
  products(storeId: ID, search: String, categoryId: ID, forSale: Boolean, after: DateTime, afterId: ID, limit: Int): [Product!]!
  product(id: ID!, storeId: ID): Product!
  productByBarcode(storeId: ID!, barcode: String!): Product!
  productCategories: [ProductCategory!]!
  catalogChanges(after: DateTime, afterId: ID, limit: Int, storeId: ID): [CatalogChange!]!
  registration: Registration!
  invitations: [Invitation!]!
  sales(storeId: ID!, after: DateTime, afterId: ID, limit: Int): [Sale!]!
  customers(storeId: ID!, search: String, after: DateTime, afterId: ID, limit: Int): [Customer!]!
  debts(storeId: ID!, status: String, after: DateTime, afterId: ID, limit: Int): [Debt!]!
  stock(storeId: ID!, after: DateTime, afterId: ID, limit: Int): [StockItem!]!
  stockInventory(id: ID!): StockInventory!
  stockTransfer(id: ID!): StockTransfer!
  stockMovements(storeId: ID!, productId: ID, type: String, actorId: ID, from: DateTime, to: DateTime, after: DateTime, afterId: ID, limit: Int): [StockMovement!]!
  stockSummary(storeId: ID): StockSummary!
  cash(storeId: ID!): [CashRegister!]!
  cashSession(id: ID!): CashSession!
  cashSessions(storeId: ID!, status: String, after: DateTime, afterId: ID, limit: Int): [CashSession!]!
  cashTransactions(sessionId: ID!, after: DateTime, afterId: ID, limit: Int): [CashTransaction!]!
  reports(storeId: ID, currency: String!, from: DateTime!, to: DateTime!): ShopReport!
  me: Me!
  mySessions: [DeviceSession!]!
  employees: [Employee!]!
  stores: [Store!]!
  myOrganizationSubscription: OrganizationSubscription!
  renewalInstructions: OrganizationSubscription!
  mySubscriptionPaymentRequests: [SubscriptionPayment!]!
  pendingSubscriptionPayments: [SubscriptionPayment!]!
  myNotifications: [AppNotification!]!
}

type Mutation {
  confirmSale(input: ConfirmSaleInput!): SaleResult!
  createCustomer(input: CreateCustomerInput!): Customer!
  receiveStock(input: ReceiveStockInput!): StockReceipt!
  openInitialStock(input: OpenInitialStockInput!): StockOpening!
  recordStockLoss(input: StockLossInput!): StockMovement!
  returnStockToSupplier(input: SupplierReturnInput!): SupplierReturn!
  createStockTransfer(input: StockTransferInput!): StockTransfer!
  dispatchStockTransfer(input: StockTransferActionInput!): StockTransfer!
  receiveStockTransfer(input: StockTransferActionInput!): StockTransfer!
  cancelStockTransfer(input: StockTransferActionInput!): StockTransfer!
  startStockInventory(input: StartStockInventoryInput!): StockInventory!
  recordInventoryCount(input: RecordInventoryCountInput!): StockInventoryLine!
  completeStockInventory(input: CompleteStockInventoryInput!): StockInventory!
  openCashSession(input: OpenCashSessionInput!): CashSession!
  closeCashSession(input: CloseCashSessionInput!): CashSession!
  createProduct(input: ProductInput!): Product!
  updateProduct(id: ID!, input: ProductInput!): Product!
  archiveProduct(id: ID!): Product!
  createProductUnit(productId: ID!, input: ProductUnitInput!): ProductUnit!
  updateProductUnit(id: ID!, input: ProductUnitInput!): ProductUnit!
  archiveProductUnit(id: ID!): ProductUnit!
  upsertProductPrice(input: ProductPriceInput!): ProductPrice!
  archiveProductPrice(id: ID!): Boolean!
  setProductDensity(input: SetProductDensityInput!): Product!
  createCompany(input: CreateCompanyInput!): CompanyCreated!
  createStore(input: CreateStoreInput!): Store!
  inviteMember(input: InviteMemberInput!): Invitation!
  revokeInvitation(id: ID!): Boolean!
  acceptInvitation(token: String!): Membership!
  requestOwnerSignupOtp(phone: String!): Boolean!
  verifyOwnerSignupOtp(phone: String!, code: String!): String!
  completeOwnerSignup(input: CompleteOwnerSignupInput!): AuthSession!
  login(input: LoginInput!): AuthSession!
  refreshSession(refreshToken: String): AuthSession!
  logout: Boolean!
  logoutAllSessions: Boolean!
  revokeSession(id: ID!): Boolean!
  changePassword(currentPassword: String!, newPassword: String!): AuthSession!
  requestPasswordResetOtp(phone: String!): Boolean!
  verifyPasswordResetOtp(phone: String!, code: String!): String!
  resetPassword(input: ResetPasswordInput!): AuthSession!
  createEmployee(input: CreateEmployeeInput!): Employee!
  updateEmployeeRole(userId: ID!, role: String!): Boolean!
  deactivateEmployee(userId: ID!): Boolean!
  reactivateEmployee(userId: ID!): Boolean!
  submitSubscriptionPayment(input: SubmitSubscriptionPaymentInput!): ID!
  approveSubscriptionPayment(id: ID!, receivedAmount: String!): DateTime!
  rejectSubscriptionPayment(id: ID!, reason: String!): Boolean!
  updateReminderPreferences(smsRemindersEnabled: Boolean!): Boolean!
  upsertPaymentInstructions(input: PaymentInstructionsInput!): Boolean!
  updateSubscriptionPlan(code: String!, monthlyPrice: String!, durationMonths: Int!): Boolean!
  registerPushDevice(token: String!, platform: String!): Boolean!
  unregisterPushDevice(token: String!): Boolean!
  markNotificationRead(id: ID!): Boolean!
}

type Subscription {
  planCode: String!
  status: String!
  source: String!
}

type CatalogChange {
  id: ID!
  sku: String!
  name: String!
  description: String
  category: ProductCategory
  categoryName: String
  barcode: String
  baseUnit: String!
  allowFractional: Boolean!
  alertThreshold: String!
  status: String!
  updatedAt: DateTime!
  archived: Boolean!
  densityKgPerLiter: String
  densityReference: String
  densityUpdatedAt: DateTime
  densityUpdatedBy: ID
  crossDimensionConversionEnabled: Boolean!
  units: [ProductUnit!]!
}

type Product {
  id: ID!
  companyId: ID!
  sku: String!
  name: String!
  description: String
  category: ProductCategory
  categoryName: String
  barcode: String
  baseUnit: String!
  allowFractional: Boolean!
  alertThreshold: String!
  status: String!
  archived: Boolean!
  # Densité kg/litre, désactivée tant que crossDimensionConversionEnabled est faux.
  densityKgPerLiter: String
  densityReference: String
  densityUpdatedAt: DateTime
  densityUpdatedBy: ID
  crossDimensionConversionEnabled: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
  units: [ProductUnit!]!
  matchedUnitId: ID
  imageMediaId: ID
  # Present when storeId was sent. Quantity is in the base unit.
  availableQuantity: String
  # available or out_of_stock. Present when storeId was sent.
  availability: String
  # Null sans la permission de marge. L'offre ne le retire pas.
  cost: ProductCost
}

type ProductCategory {
  id: ID!
  name: String!
}

type ProductUnit {
  id: ID!
  productId: ID!
  name: String!
  factor: String!
  # count, mass ou volume. count par défaut. Le stock reste dans l'unité de base.
  dimension: String!
  barcode: String
  isBase: Boolean!
  active: Boolean!
  allowPurchase: Boolean!
  allowSale: Boolean!
  allowFractional: Boolean!
  prices: [ProductPrice!]!
}

type ProductPrice {
  id: ID!
  storeId: ID!
  productId: ID!
  productUnitId: ID!
  currency: String!
  unitPrice: String!
}

type ProductCost {
  currency: String
  avgCost: String
  costComplete: Boolean!
}

input ProductInput {
  sku: String
  name: String
  description: String
  categoryId: ID
  categoryName: String
  barcode: String
  baseUnit: String
  # count, mass ou volume. Vide signifie count.
  baseDimension: String
  allowFractional: Boolean
  alertThreshold: String
  storeId: ID
  units: [ProductUnitInput!]
  prices: [ProductPriceInput!]
}

input ProductUnitInput {
  name: String!
  factor: String!
  dimension: String
  barcode: String
  allowPurchase: Boolean
  allowSale: Boolean
  allowFractional: Boolean
}

input SetProductDensityInput {
  productId: ID!
  densityKgPerLiter: String
  densityReference: String
  enabled: Boolean!
}

input ProductPriceInput {
  storeId: ID
  productId: ID
  productUnitId: ID
  unitName: String
  currency: String
  unitPrice: String
}

type Registration {
  companyId: ID
  companyName: String
  primaryCurrency: String
  clerkLinked: Boolean!
  trialEndsAt: DateTime
  steps: [RegistrationStep!]!
}

type RegistrationStep {
  code: String!
  label: String!
  done: Boolean!
}

type CompanyCreated {
  companyId: ID!
  storeId: ID
  role: String!
  primaryCurrency: String!
  trialEndsAt: DateTime!
}

type Invitation {
  id: ID!
  email: String!
  role: String!
  storeId: ID
  status: String!
  expiresAt: DateTime!
  token: String
}

type Membership {
  companyId: ID!
  role: String!
  storeId: ID
}

type Sale {
  id: ID!
  storeId: ID!
  customerId: ID
  currency: String!
  netAmount: String!
  paidAmount: String!
  dueAmount: String!
  createdAt: DateTime!
  lines: [SaleLine!]!
}

type SaleLine {
  productId: ID!
  unitName: String!
  quantity: String!
  unitPrice: String!
  lineNet: String!
}

type Customer {
  id: ID!
  storeId: ID!
  name: String!
  phone: String
  whatsappPhone: String
  address: String
  notes: String
  creditLimit: String
  # Null when the caller cannot read debts. Empty when none are open.
  openDebts: [MoneyAmount!]
  createdAt: DateTime!
}

type Debt {
  id: ID!
  storeId: ID!
  customerId: ID!
  customerName: String!
  saleId: ID!
  currency: String!
  originalAmount: String!
  collectedAmount: String!
  dueAmount: String!
  # Cash or external amount paid when the sale was confirmed. Later repayments stay in collectedAmount.
  advanceAmount: String!
  # Calendar date YYYY-MM-DD. Null on debts created before the due date was required.
  dueOn: String
  # open (unpaid), partial, settled (paid). overdue is a filter, not a stored status.
  status: String!
  overdue: Boolean!
  createdAt: DateTime!
}

type StockItem {
  productId: ID!
  sku: String!
  name: String!
  baseUnit: String!
  quantity: String!
  alertThreshold: String!
  belowAlert: Boolean!
  updatedAt: DateTime!
}

type StockReceipt {
  id: ID!
  storeId: ID!
  supplierId: ID
  currency: String!
  totalCost: String!
  reference: String
  note: String
  lines: [StockReceiptLine!]!
}

type StockReceiptLine {
  productId: ID!
  productUnitId: ID!
  unitName: String!
  quantity: String!
  baseQuantity: String!
  unitCost: String!
  lineCost: String!
}

input ReceiveStockInput {
  idempotencyKey: String!
  storeId: ID!
  supplierId: ID
  supplierName: String
  currency: String!
  reference: String
  note: String
  lines: [ReceiveStockLineInput!]!
}

input ReceiveStockLineInput {
  productId: ID!
  productUnitId: ID
  unitName: String
  quantity: String!
  unitCost: String!
}

type StockOpening {
  id: ID!
  storeId: ID!
  note: String
  createdBy: ID!
  createdAt: DateTime!
  lines: [StockOpeningLine!]!
}

type StockOpeningLine {
  productId: ID!
  productUnitId: ID!
  unitName: String!
  quantity: String!
  factor: String!
  baseQuantity: String!
  unitCost: String
  currency: String
  lineCost: String
}

input OpenInitialStockInput {
  idempotencyKey: String!
  storeId: ID!
  note: String
  lines: [OpenInitialStockLineInput!]!
}

input OpenInitialStockLineInput {
  productId: ID!
  productUnitId: ID!
  quantity: String!
  unitCost: String
  currency: String
}

input StockLossInput {
  idempotencyKey: String!
  storeId: ID!
  productId: ID!
  productUnitId: ID!
  quantity: String!
  reason: String!
  note: String
}

type SupplierReturn {
  id: ID!
  storeId: ID!
  supplierId: ID
  reference: String
  reason: String!
  createdAt: DateTime!
  lines: [SupplierReturnLine!]!
}

type SupplierReturnLine {
  productId: ID!
  productUnitId: ID!
  unitName: String!
  quantity: String!
  factor: String!
  baseQuantity: String!
}

input SupplierReturnInput {
  idempotencyKey: String!
  storeId: ID!
  supplierId: ID
  supplierName: String
  reference: String
  reason: String!
  lines: [SupplierReturnLineInput!]!
}

input SupplierReturnLineInput {
  productId: ID!
  productUnitId: ID!
  quantity: String!
}

type StockTransfer {
  id: ID!
  sourceStoreId: ID!
  destinationStoreId: ID!
  status: String!
  reference: String
  note: String
  version: Int!
  inTransit: String!
  createdBy: ID!
  createdAt: DateTime!
  lines: [StockTransferLine!]!
  events: [StockTransferEvent!]!
}

type StockTransferLine {
  productId: ID!
  productUnitId: ID!
  unitName: String!
  quantity: String!
  factor: String!
  baseQuantity: String!
}

type StockTransferEvent {
  fromStatus: String
  toStatus: String!
  actorId: ID
  createdAt: DateTime!
}

input StockTransferInput {
  idempotencyKey: String!
  sourceStoreId: ID!
  destinationStoreId: ID!
  reference: String
  note: String
  lines: [StockTransferLineInput!]!
}

input StockTransferLineInput {
  productId: ID!
  productUnitId: ID!
  quantity: String!
}

input StockTransferActionInput {
  idempotencyKey: String!
  id: ID!
}

type StockInventory {
  id: ID!
  companyId: ID!
  storeId: ID!
  createdBy: ID!
  status: String!
  note: String
  startedAt: DateTime!
  completedAt: DateTime
  lines: [StockInventoryLine!]!
}

type StockInventoryLine {
  id: ID!
  productId: ID!
  productName: String!
  productUnitId: ID!
  unitName: String!
  factor: String!
  countedQuantity: String!
  baseQuantity: String!
  theoreticalQuantity: String!
  countedBaseTotal: String!
  variance: String!
  varianceValue: String
  varianceCurrency: String
  costIncomplete: Boolean!
  reason: String
}

input StartStockInventoryInput {
  storeId: ID!
  note: String
}

input RecordInventoryCountInput {
  inventoryId: ID!
  productId: ID!
  productUnitId: ID!
  countedQuantity: String!
  reason: String
}

input CompleteStockInventoryInput {
  inventoryId: ID!
}

type StockMovement {
  id: ID!
  productId: ID!
  sku: String!
  productName: String!
  storeId: ID!
  type: String!
  quantity: String!
  originUnit: String
  originQuantity: String
  # Facteur du conditionnement utilisé pour ce mouvement. Absent si l'historique ne le prouve pas.
  originFactor: String
  originProvenance: String!
  # Densité utilisée pour cette conversion kg/litre. Absente si le mouvement est resté dans la même dimension. Ce n'est pas un coût.
  densityKgPerLiter: String
  refType: String
  refId: ID
  actorId: ID
  reason: String
  createdAt: DateTime!
}

# stockCostValues et incompleteCostProducts sont nuls sans le droit de valorisation
# et le droit de marge. L'offre ne les retire pas. USD et CDF ne sont jamais additionnés.
type StockSummary {
  totalProducts: Int!
  productsInStock: Int!
  outOfStockProducts: Int!
  lowStockProducts: Int!
  stockCostValues: [MoneyAmount!]
  costMethod: String!
  stockRetailValues: [MoneyAmount!]!
  retailMethod: String!
  incompleteCostProducts: Int
  incompleteRetailProducts: Int!
  updatedAt: DateTime!
}

type CashRegister {
  id: ID!
  name: String!
  openSession: CashSession
}

# Session de caisse. Les listes de montants sont nulles si l'appelant ne peut pas les voir.
# balances et theoreticalBalances sont le même solde par devise : initial + entrées - sorties.
# USD et CDF ne sont jamais additionnés.
type CashSession {
  id: ID!
  storeId: ID!
  cashRegisterId: ID!
  openedBy: ID!
  closedBy: ID
  openedAt: DateTime!
  closedAt: DateTime
  status: String!
  openingBalances: [MoneyAmount!]
  totalIn: [MoneyAmount!]
  totalOut: [MoneyAmount!]
  balances: [MoneyAmount!]
  theoreticalBalances: [MoneyAmount!]
  countedBalances: [MoneyAmount!]
  variances: [MoneyAmount!]
  note: String
  transactions: [CashTransaction!]
}

type CashTransaction {
  id: ID!
  currency: String!
  direction: String!
  kind: String!
  amount: String!
  createdBy: ID!
  createdAt: DateTime!
}

type MoneyAmount {
  currency: String!
  amount: String!
}

type ShopReport {
  netSales: MoneyAmount!
  paymentsByMethod: [MethodTotal!]!
  openDebts: DebtBook!
  expenses: MoneyAmount!
  lowStock: [LowStockItem!]!
  topProducts: [TopProduct!]!
  grossMargin: GrossMargin
  cashCounts: [CashCount!]!
}

type MethodTotal {
  method: String!
  currency: String!
  amount: String!
}

type DebtBook {
  currency: String!
  openAmount: String!
  overdueAmount: String!
}

type LowStockItem {
  storeId: ID!
  sku: String!
  name: String!
  quantity: String!
}

type TopProduct {
  sku: String!
  name: String!
  quantity: String!
  netAmount: String!
  currency: String!
}

# Marge brute. Ce n'est pas le bénéfice net. Null si le rôle ne l'autorise pas. L'offre ne la retire pas.
type GrossMargin {
  currency: String!
  netSales: String!
  costOfGoods: String!
  grossMargin: String!
  marginIncomplete: Boolean!
}

type CashCount {
  currency: String!
  expectedAmount: String!
  countedAmount: String!
  variance: String!
}

input CreateCompanyInput {
  name: String!
  primaryCurrency: String!
  storeName: String!
  timezone: String
}

input CreateStoreInput {
  name: String!
  timezone: String
}

input InviteMemberInput {
  email: String!
  role: String!
  storeId: ID
}

input ConfirmSaleInput {
  idempotencyKey: String!
  storeId: ID!
  customerId: ID
  currency: String!
  lines: [SaleLineInput!]!
  payments: [PaymentInput!]!
  cashSessionId: ID
  # Calendar date YYYY-MM-DD. Required when payments do not cover the sale.
  debtDueDate: String
}

input CreateCustomerInput {
  storeId: ID!
  name: String!
  address: String!
  phone: String
  whatsappPhone: String
  notes: String
}

input MoneyInput {
  currency: String!
  amount: String!
}

input OpenCashSessionInput {
  storeId: ID!
  cashRegisterId: ID!
  openingBalances: [MoneyInput!]!
}

input CountedBalanceInput {
  currency: String!
  amount: String!
}

input CloseCashSessionInput {
  cashSessionId: ID!
  countedBalances: [CountedBalanceInput!]!
  note: String
}

input SaleLineInput {
  productId: ID!
  unitName: String!
  quantity: String!
  expectedUnitPrice: String!
}

input PaymentInput {
  method: String!
  amount: String!
  externalReference: String
}

type SaleResult {
  saleId: ID!
  reference: String!
  currency: String!
  netAmount: String!
  paidAmount: String!
  dueAmount: String!
  debtId: ID
  # Calendar date YYYY-MM-DD when a debt was created.
  debtDueDate: String
  customerId: ID
  customerName: String
  createdAt: DateTime
  itemCount: Int
}

scalar DateTime

type AuthSession {
  accessToken: String!
  refreshToken: String
  expiresAt: DateTime!
  sessionId: ID!
  userId: ID!
  companyId: ID
  role: String
  scope: String!
  mustChangePassword: Boolean!
  csrfToken: String
}

type Me {
  id: ID!
  fullName: String!
  phone: String
  phoneVerified: Boolean!
  email: String
  mustChangePassword: Boolean!
  companies: [MyCompany!]!
}

type MyCompany {
  companyId: ID!
  companyName: String!
  role: String!
  status: String!
  storeIds: [ID!]!
}

type DeviceSession {
  id: ID!
  companyId: ID
  scope: String!
  createdAt: DateTime!
  lastRefreshAt: DateTime!
  expiresAt: DateTime!
  current: Boolean!
  userAgent: String
}

type Employee {
  userId: ID!
  fullName: String!
  phone: String
  role: String!
  status: String!
  mustChangePassword: Boolean!
  phoneVerified: Boolean!
  storeIds: [ID!]!
}

# Boutiques ouvertes de l'entreprise en session.
# Le propriétaire et l'administrateur d'organisation les voient toutes.
# Les autres rôles ne voient que leurs affectations.
type Store {
  id: ID!
  name: String!
  timezone: String!
  cashRegister: StoreCashRegister
}

type StoreCashRegister {
  id: ID!
  name: String!
}

type OrganizationSubscription {
  companyId: ID!
  companyName: String!
  role: String!
  lifecycle: String!
  status: String!
  planCode: String!
  planName: String!
  amount: String
  currency: String
  durationMonths: Int
  expiresAt: DateTime
  timezone: String!
  message: String
  banner: String
  canDeclarePayment: Boolean!
  renewalReference: String
  operatorName: String
  destinationAccount: String
  beneficiaryName: String
  paymentInstructions: String
  paymentStatus: String
  paymentReason: String
  newExpiresAt: DateTime
}

type SubscriptionPayment {
  id: ID!
  status: String!
  expectedAmount: String!
  declaredAmount: String!
  currency: String!
  externalReference: String!
  decisionReason: String
  createdAt: DateTime!
  newExpiresAt: DateTime
}

type AppNotification {
  id: ID!
  kind: String!
  body: String
  createdAt: DateTime!
  readAt: DateTime
}

input CompleteOwnerSignupInput {
  grant: String!
  phone: String!
  fullName: String!
  password: String!
  email: String
  companyName: String!
  primaryCurrency: String!
  timezone: String
  client: String
}

input LoginInput {
  phone: String!
  password: String!
  companyId: ID
  client: String
}

input ResetPasswordInput {
  grant: String!
  phone: String!
  password: String!
  client: String
}

input CreateEmployeeInput {
  fullName: String!
  phone: String!
  role: String!
  password: String!
  storeId: ID
}

input SubmitSubscriptionPaymentInput {
  externalReference: String!
  declaredAmount: String!
  proofKey: String
}

input PaymentInstructionsInput {
  operatorName: String!
  destinationAccount: String!
  beneficiaryName: String!
  currency: String!
  instructions: String!
}
