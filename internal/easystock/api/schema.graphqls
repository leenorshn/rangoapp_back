# Contract for POST /graphql. The executable schema is graphql.go.
# Amounts and quantities are decimal strings, never floats.
# Dates use the DateTime scalar (RFC3339).

type Query {
  subscription: Subscription!
  products(storeId: ID, search: String, categoryId: ID, after: DateTime, afterId: ID, limit: Int): [Product!]!
  product(id: ID!, storeId: ID): Product!
  productByBarcode(storeId: ID!, barcode: String!): Product!
  productCategories: [ProductCategory!]!
  catalogChanges(after: DateTime, afterId: ID, limit: Int, storeId: ID): [CatalogChange!]!
  registration: Registration!
  invitations: [Invitation!]!
  sales(storeId: ID!, after: DateTime, afterId: ID, limit: Int): [Sale!]!
  customers(storeId: ID!, after: DateTime, afterId: ID, limit: Int): [Customer!]!
  debts(storeId: ID!, status: String, after: DateTime, afterId: ID, limit: Int): [Debt!]!
  stock(storeId: ID!, after: DateTime, afterId: ID, limit: Int): [StockItem!]!
  cash(storeId: ID!): [CashRegister!]!
  cashSession(id: ID!): CashSession!
  cashSessions(storeId: ID!, status: String, after: DateTime, afterId: ID, limit: Int): [CashSession!]!
  cashTransactions(sessionId: ID!, after: DateTime, afterId: ID, limit: Int): [CashTransaction!]!
  reports(storeId: ID, currency: String!, from: DateTime!, to: DateTime!): ShopReport!
  me: Me!
  mySessions: [DeviceSession!]!
  employees: [Employee!]!
  stores: [Store!]!
  myOrganizationSubscription: OrganizationSubscription!
  renewalInstructions: OrganizationSubscription!
  mySubscriptionPaymentRequests: [SubscriptionPayment!]!
  pendingSubscriptionPayments: [SubscriptionPayment!]!
  myNotifications: [AppNotification!]!
}

type Mutation {
  confirmSale(input: ConfirmSaleInput!): SaleResult!
  openCashSession(input: OpenCashSessionInput!): CashSession!
  closeCashSession(input: CloseCashSessionInput!): CashSession!
  createProduct(input: ProductInput!): Product!
  updateProduct(id: ID!, input: ProductInput!): Product!
  archiveProduct(id: ID!): Product!
  createProductUnit(productId: ID!, input: ProductUnitInput!): ProductUnit!
  updateProductUnit(id: ID!, input: ProductUnitInput!): ProductUnit!
  archiveProductUnit(id: ID!): ProductUnit!
  upsertProductPrice(input: ProductPriceInput!): ProductPrice!
  archiveProductPrice(id: ID!): Boolean!
  createCompany(input: CreateCompanyInput!): CompanyCreated!
  createStore(input: CreateStoreInput!): Store!
  inviteMember(input: InviteMemberInput!): Invitation!
  revokeInvitation(id: ID!): Boolean!
  acceptInvitation(token: String!): Membership!
  requestOwnerSignupOtp(phone: String!): Boolean!
  verifyOwnerSignupOtp(phone: String!, code: String!): String!
  completeOwnerSignup(input: CompleteOwnerSignupInput!): AuthSession!
  login(input: LoginInput!): AuthSession!
  refreshSession(refreshToken: String): AuthSession!
  logout: Boolean!
  logoutAllSessions: Boolean!
  revokeSession(id: ID!): Boolean!
  changePassword(currentPassword: String!, newPassword: String!): AuthSession!
  requestPasswordResetOtp(phone: String!): Boolean!
  verifyPasswordResetOtp(phone: String!, code: String!): String!
  resetPassword(input: ResetPasswordInput!): AuthSession!
  createEmployee(input: CreateEmployeeInput!): Employee!
  updateEmployeeRole(userId: ID!, role: String!): Boolean!
  deactivateEmployee(userId: ID!): Boolean!
  reactivateEmployee(userId: ID!): Boolean!
  submitSubscriptionPayment(input: SubmitSubscriptionPaymentInput!): ID!
  approveSubscriptionPayment(id: ID!, receivedAmount: String!): DateTime!
  rejectSubscriptionPayment(id: ID!, reason: String!): Boolean!
  updateReminderPreferences(smsRemindersEnabled: Boolean!): Boolean!
  upsertPaymentInstructions(input: PaymentInstructionsInput!): Boolean!
  updateSubscriptionPlan(code: String!, monthlyPrice: String!, durationMonths: Int!): Boolean!
  registerPushDevice(token: String!, platform: String!): Boolean!
  unregisterPushDevice(token: String!): Boolean!
  markNotificationRead(id: ID!): Boolean!
}

type Subscription {
  planCode: String!
  status: String!
  source: String!
}

type CatalogChange {
  id: ID!
  sku: String!
  name: String!
  description: String
  category: ProductCategory
  categoryName: String
  barcode: String
  baseUnit: String!
  allowFractional: Boolean!
  alertThreshold: String!
  status: String!
  updatedAt: DateTime!
  archived: Boolean!
  units: [ProductUnit!]!
}

type Product {
  id: ID!
  companyId: ID!
  sku: String!
  name: String!
  description: String
  category: ProductCategory
  categoryName: String
  barcode: String
  baseUnit: String!
  allowFractional: Boolean!
  alertThreshold: String!
  status: String!
  archived: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
  units: [ProductUnit!]!
  matchedUnitId: ID
  # Null sans la permission de marge ou sans l'offre qui l'inclut.
  cost: ProductCost
}

type ProductCategory {
  id: ID!
  name: String!
}

type ProductUnit {
  id: ID!
  productId: ID!
  name: String!
  factor: String!
  barcode: String
  isBase: Boolean!
  active: Boolean!
  prices: [ProductPrice!]!
}

type ProductPrice {
  id: ID!
  storeId: ID!
  productId: ID!
  productUnitId: ID!
  currency: String!
  unitPrice: String!
}

type ProductCost {
  currency: String
  avgCost: String
  costComplete: Boolean!
}

input ProductInput {
  sku: String
  name: String
  description: String
  categoryId: ID
  categoryName: String
  barcode: String
  baseUnit: String
  allowFractional: Boolean
  alertThreshold: String
  storeId: ID
  units: [ProductUnitInput!]
  prices: [ProductPriceInput!]
}

input ProductUnitInput {
  name: String!
  factor: String!
  barcode: String
}

input ProductPriceInput {
  storeId: ID
  productId: ID
  productUnitId: ID
  unitName: String
  currency: String
  unitPrice: String
}

type Registration {
  companyId: ID
  companyName: String
  primaryCurrency: String
  clerkLinked: Boolean!
  trialEndsAt: DateTime
  steps: [RegistrationStep!]!
}

type RegistrationStep {
  code: String!
  label: String!
  done: Boolean!
}

type CompanyCreated {
  companyId: ID!
  storeId: ID
  role: String!
  primaryCurrency: String!
  trialEndsAt: DateTime!
}

type Invitation {
  id: ID!
  email: String!
  role: String!
  storeId: ID
  status: String!
  expiresAt: DateTime!
  token: String
}

type Membership {
  companyId: ID!
  role: String!
  storeId: ID
}

type Sale {
  id: ID!
  storeId: ID!
  customerId: ID
  currency: String!
  netAmount: String!
  paidAmount: String!
  dueAmount: String!
  createdAt: DateTime!
  lines: [SaleLine!]!
}

type SaleLine {
  productId: ID!
  unitName: String!
  quantity: String!
  unitPrice: String!
  lineNet: String!
}

type Customer {
  id: ID!
  storeId: ID!
  name: String!
  phone: String
  notes: String
  creditLimit: String
  createdAt: DateTime!
}

type Debt {
  id: ID!
  storeId: ID!
  customerId: ID!
  customerName: String!
  saleId: ID!
  currency: String!
  originalAmount: String!
  collectedAmount: String!
  dueAmount: String!
  dueOn: String
  status: String!
  createdAt: DateTime!
}

type StockItem {
  productId: ID!
  sku: String!
  name: String!
  baseUnit: String!
  quantity: String!
  alertThreshold: String!
  belowAlert: Boolean!
  updatedAt: DateTime!
}

type CashRegister {
  id: ID!
  name: String!
  openSession: CashSession
}

# Session de caisse. Les listes de montants sont nulles si l'appelant ne peut pas les voir.
# balances et theoreticalBalances sont le même solde par devise : initial + entrées - sorties.
# USD et CDF ne sont jamais additionnés.
type CashSession {
  id: ID!
  storeId: ID!
  cashRegisterId: ID!
  openedBy: ID!
  closedBy: ID
  openedAt: DateTime!
  closedAt: DateTime
  status: String!
  openingBalances: [MoneyAmount!]
  totalIn: [MoneyAmount!]
  totalOut: [MoneyAmount!]
  balances: [MoneyAmount!]
  theoreticalBalances: [MoneyAmount!]
  countedBalances: [MoneyAmount!]
  variances: [MoneyAmount!]
  note: String
  transactions: [CashTransaction!]
}

type CashTransaction {
  id: ID!
  currency: String!
  direction: String!
  kind: String!
  amount: String!
  createdBy: ID!
  createdAt: DateTime!
}

type MoneyAmount {
  currency: String!
  amount: String!
}

type ShopReport {
  netSales: MoneyAmount!
  paymentsByMethod: [MethodTotal!]!
  openDebts: DebtBook!
  expenses: MoneyAmount!
  lowStock: [LowStockItem!]!
  topProducts: [TopProduct!]!
  grossMargin: GrossMargin
  cashCounts: [CashCount!]!
}

type MethodTotal {
  method: String!
  currency: String!
  amount: String!
}

type DebtBook {
  currency: String!
  openAmount: String!
  overdueAmount: String!
}

type LowStockItem {
  storeId: ID!
  sku: String!
  name: String!
  quantity: String!
}

type TopProduct {
  sku: String!
  name: String!
  quantity: String!
  netAmount: String!
  currency: String!
}

# Marge brute. Ce n'est pas le bénéfice net. Null si l'offre ou le rôle ne l'autorise pas.
type GrossMargin {
  currency: String!
  netSales: String!
  costOfGoods: String!
  grossMargin: String!
  marginIncomplete: Boolean!
}

type CashCount {
  currency: String!
  expectedAmount: String!
  countedAmount: String!
  variance: String!
}

input CreateCompanyInput {
  name: String!
  primaryCurrency: String!
  storeName: String!
  timezone: String
}

input CreateStoreInput {
  name: String!
  timezone: String
}

input InviteMemberInput {
  email: String!
  role: String!
  storeId: ID
}

input ConfirmSaleInput {
  idempotencyKey: String!
  storeId: ID!
  customerId: ID
  currency: String!
  lines: [SaleLineInput!]!
  payments: [PaymentInput!]!
  cashSessionId: ID
}

input MoneyInput {
  currency: String!
  amount: String!
}

input OpenCashSessionInput {
  storeId: ID!
  cashRegisterId: ID!
  openingBalances: [MoneyInput!]!
}

input CountedBalanceInput {
  currency: String!
  amount: String!
}

input CloseCashSessionInput {
  cashSessionId: ID!
  countedBalances: [CountedBalanceInput!]!
  note: String
}

input SaleLineInput {
  productId: ID!
  unitName: String!
  quantity: String!
  expectedUnitPrice: String!
}

input PaymentInput {
  method: String!
  amount: String!
  externalReference: String
}

type SaleResult {
  saleId: ID!
  currency: String!
  netAmount: String!
  paidAmount: String!
  dueAmount: String!
  debtId: ID
}

scalar DateTime

type AuthSession {
  accessToken: String!
  refreshToken: String
  expiresAt: DateTime!
  sessionId: ID!
  userId: ID!
  companyId: ID
  role: String
  scope: String!
  mustChangePassword: Boolean!
  csrfToken: String
}

type Me {
  id: ID!
  fullName: String!
  phone: String
  phoneVerified: Boolean!
  email: String
  mustChangePassword: Boolean!
  companies: [MyCompany!]!
}

type MyCompany {
  companyId: ID!
  companyName: String!
  role: String!
  status: String!
  storeIds: [ID!]!
}

type DeviceSession {
  id: ID!
  companyId: ID
  scope: String!
  createdAt: DateTime!
  lastRefreshAt: DateTime!
  expiresAt: DateTime!
  current: Boolean!
  userAgent: String
}

type Employee {
  userId: ID!
  fullName: String!
  phone: String
  role: String!
  status: String!
  mustChangePassword: Boolean!
  phoneVerified: Boolean!
  storeIds: [ID!]!
}

# Boutiques ouvertes de l'entreprise en session.
# Le propriétaire et l'administrateur d'organisation les voient toutes.
# Les autres rôles ne voient que leurs affectations.
type Store {
  id: ID!
  name: String!
  timezone: String!
  cashRegister: StoreCashRegister
}

type StoreCashRegister {
  id: ID!
  name: String!
}

type OrganizationSubscription {
  companyId: ID!
  companyName: String!
  role: String!
  lifecycle: String!
  status: String!
  planCode: String!
  planName: String!
  amount: String
  currency: String
  durationMonths: Int
  expiresAt: DateTime
  timezone: String!
  message: String
  banner: String
  canDeclarePayment: Boolean!
  renewalReference: String
  operatorName: String
  destinationAccount: String
  beneficiaryName: String
  paymentInstructions: String
  paymentStatus: String
  paymentReason: String
  newExpiresAt: DateTime
}

type SubscriptionPayment {
  id: ID!
  status: String!
  expectedAmount: String!
  declaredAmount: String!
  currency: String!
  externalReference: String!
  decisionReason: String
  createdAt: DateTime!
  newExpiresAt: DateTime
}

type AppNotification {
  id: ID!
  kind: String!
  body: String
  createdAt: DateTime!
  readAt: DateTime
}

input CompleteOwnerSignupInput {
  grant: String!
  phone: String!
  fullName: String!
  password: String!
  email: String
  companyName: String!
  primaryCurrency: String!
  timezone: String
  client: String
}

input LoginInput {
  phone: String!
  password: String!
  companyId: ID
  client: String
}

input ResetPasswordInput {
  grant: String!
  phone: String!
  password: String!
  client: String
}

input CreateEmployeeInput {
  fullName: String!
  phone: String!
  role: String!
  password: String!
  storeId: ID
}

input SubmitSubscriptionPaymentInput {
  externalReference: String!
  declaredAmount: String!
  proofKey: String
}

input PaymentInstructionsInput {
  operatorName: String!
  destinationAccount: String!
  beneficiaryName: String!
  currency: String!
  instructions: String!
}
