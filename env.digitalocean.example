# Copy to .env on the droplet. scripts/setup-droplet.sh generates this file
# with random passwords when .env is absent.
# Passwords are embedded in PostgreSQL URLs: use hex (openssl rand -hex 24),
# with no spaces, quotes, or dollar signs.

POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
JOB_DB_PASSWORD=change-me
INTERNAL_CONTEXT_SECRET=change-me-to-a-random-string-of-32-or-more

# Production refuses the simulated SMS and push providers.
APP_ENV=production
AUTH_JWT_SECRET=change-me-to-a-random-string-of-32-or-more
AUTH_OTP_SECRET=change-me-to-a-different-random-string-32
PHONE_DEFAULT_REGION=CD
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
PUSH_PROVIDER=http
PUSH_HTTP_URL=
PUSH_HTTP_TOKEN=
REDIS_URL=redis://redis:6379/0
AUTH_CORS_ORIGINS=
AUTH_COOKIE_SECURE=true

# DigitalOcean Spaces. Leave S3_BUCKET empty to refuse uploads.
# Endpoint example: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=
S3_REGION=nyc3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

# :80 serves HTTP on the droplet IP. Set a domain name to enable HTTPS.
SITE_ADDRESS=:80

# easystock:local builds on the droplet. GitHub Actions replaces this with
# registry.digitalocean.com/<registry>/easystock:<sha> and sets the policy to always.
EASYSTOCK_IMAGE=easystock:local
EASYSTOCK_PULL_POLICY=missing
