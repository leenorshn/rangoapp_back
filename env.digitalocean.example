# Variables for DigitalOcean. Copy to .env on the droplet or set them as secrets.
DATABASE_URL=postgres://easystock_migrator:change-me@127.0.0.1:5432/easystock?sslmode=require
DATABASE_URL_APP=postgres://easystock_app:change-me@127.0.0.1:5432/easystock?sslmode=require
DATABASE_URL_IDENTITY=postgres://easystock_identity:change-me@127.0.0.1:5432/easystock?sslmode=require
DATABASE_URL_JOB=postgres://easystock_job:change-me@127.0.0.1:5432/easystock?sslmode=require
PORT=8080
INTERNAL_CONTEXT_SECRET=change-me-to-a-random-string-of-32-or-more
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
COMMERCE_GRPC_ADDR=127.0.0.1:7443
GRPC_TLS_CA=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true
