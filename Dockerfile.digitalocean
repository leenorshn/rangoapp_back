FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -o /easystock \
    ./cmd/easystock

FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata wget

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

COPY --from=builder /easystock /app/easystock
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

RUN chown -R appuser:appuser /app

USER appuser

# api listens on 8080. grpc listens on 7443 and is not published.
EXPOSE 8080

# No image-level health check: migrate and grpc share this image, and a probe
# of :8080 would mark those processes unhealthy. Compose and App Platform
# probe the api service only.
ENTRYPOINT ["/app/easystock"]
CMD ["api"]
