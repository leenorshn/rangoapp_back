# EasyStock PostgreSQL. Do not put production secrets in this file.
DATABASE_URL=postgres://easystock_migrator:change-me@127.0.0.1:5432/easystock?sslmode=disable
DATABASE_URL_APP=postgres://easystock_app:change-me@127.0.0.1:5432/easystock?sslmode=disable
DATABASE_URL_IDENTITY=postgres://easystock_identity:change-me@127.0.0.1:5432/easystock?sslmode=disable
DATABASE_URL_JOB=postgres://easystock_job:change-me@127.0.0.1:5432/easystock?sslmode=disable
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
JOB_DB_PASSWORD=change-me

PORT=8080
# GraphQL Playground at GET /playground. Leave empty outside local development.
GRAPHQL_PLAYGROUND=true
INTERNAL_CONTEXT_SECRET=change-me-to-a-random-string-of-32-or-more

# Local auth. Both secrets must be at least 32 characters. Never reuse these placeholders.
APP_ENV=development
AUTH_JWT_SECRET=change-me-to-a-random-string-of-32-or-more
AUTH_OTP_SECRET=change-me-to-a-different-random-string-32
PHONE_DEFAULT_REGION=CD
# dev logs a simulated SMS and does not deliver it. http posts to SMS_HTTP_URL.
# uzashop posts to UZASHOP SMS Management V2 (POST /api/v2/sms/send).
# APP_ENV=production refuses SMS_PROVIDER=dev and PUSH_PROVIDER=dev.
# +243978154329 always accepts OTP code 123123, including in the cloud. No SMS is sent for that number.
SMS_PROVIDER=dev
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# Required when SMS_PROVIDER=uzashop. tokenKey from the UZASHOP subscription.
SMS_UZA_TOKEN=
# Optional. Default sender is EasyStock, at most 11 characters.
SMS_UZA_SENDER=
# Optional. Default https://sms.uzashop.co
SMS_UZA_BASE_URL=
PUSH_PROVIDER=dev
PUSH_HTTP_URL=
PUSH_HTTP_TOKEN=
# Empty REDIS_URL stores rate limits in PostgreSQL.
REDIS_URL=
AUTH_CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=
GRPC_LISTEN=127.0.0.1:7443
COMMERCE_GRPC_ADDR=127.0.0.1:7443
# Leave empty in production. Set only on a private Docker network without TLS.
GRPC_INSECURE_DEV=
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=

# S3-compatible storage for product images and expense receipts. Leave the bucket empty to refuse uploads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=
